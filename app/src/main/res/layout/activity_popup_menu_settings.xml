<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Popup menu"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <!-- ============================================================== -->
            <!-- LIVE PREVIEW CARD -->
            <!-- ============================================================== -->
            <FrameLayout
                android:id="@+id/cardPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_rounded"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <!-- Simulated Anchor App Icon -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivPreviewAnchorIcon"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:src="@drawable/ic_messages"
                            android:contentDescription="Preview Anchor" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="LauncherAI"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Dynamic Floating Popup Menu Bubble -->
                    <LinearLayout
                        android:id="@+id/layoutPreviewPopupBubble"
                        android:layout_width="260dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:elevation="8dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_card_rounded">

                        <!-- Top Header Actions Row -->
                        <LinearLayout
                            android:id="@+id/layoutPreviewHeaderActions"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/ivPreviewActionInfo"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_info"
                                app:tint="@color/text_primary"
                                android:contentDescription="App Info" />

                            <ImageView
                                android:id="@+id/ivPreviewActionEdit"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="12dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_edit"
                                app:tint="@color/text_primary"
                                android:contentDescription="Edit" />

                            <ImageView
                                android:id="@+id/ivPreviewActionWidgets"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="12dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_widgets"
                                app:tint="@color/text_primary"
                                android:contentDescription="Widgets" />

                            <ImageView
                                android:id="@+id/ivPreviewActionShare"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_marginStart="12dp"
                                android:padding="8dp"
                                android:src="@drawable/ic_share"
                                app:tint="@color/text_primary"
                                android:contentDescription="Share" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:id="@+id/previewDivider1"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="6dp"
                            android:background="@color/divider" />

                        <!-- App Shortcuts Preview -->
                        <LinearLayout
                            android:id="@+id/layoutPreviewShortcuts"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Shortcut Item 1 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_plus"
                                    app:tint="@color/nova_orange"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="New Conversation"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />
                            </LinearLayout>

                            <!-- Shortcut Item 2 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="36dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="8dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_search"
                                    app:tint="@color/accent_cyan"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:text="Search Prompts"
                                    android:textColor="@color/text_primary"
                                    android:textSize="13sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:id="@+id/previewDivider2"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="6dp"
                            android:background="@color/divider" />

                        <!-- Notifications Preview Section -->
                        <LinearLayout
                            android:id="@+id/layoutPreviewNotifications"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="8dp"
                            android:paddingBottom="4dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notifications"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_notifications"
                                    app:tint="@color/nova_orange"
                                    android:contentDescription="@null" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="DeepMind: Model 2.0 Ready"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- ============================================================== -->
            <!-- SECTION: STYLING -->
            <!-- ============================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="STYLING"
                android:textColor="@color/nova_orange"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Card Background Switch -->
            <LinearLayout
                android:id="@+id/rowCardBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Card background"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Draw a rounded card container behind the popup menu"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swCardBg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- Visually Group Shortcuts Switch -->
            <LinearLayout
                android:id="@+id/rowGroupShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Visually group shortcuts"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Group app shortcuts together separately from actions"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swGroupShortcuts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />
            </LinearLayout>

            <!-- Corner Radius Slider -->
            <LinearLayout
                android:id="@+id/rowCornerRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Corner radius"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvCornerRadiusValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8dp"
                        android:textColor="@color/nova_orange"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnRadiusDec"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Decrease"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/text_primary" />

                    <SeekBar
                        android:id="@+id/sbCornerRadius"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="28"
                        android:progress="8"
                        android:progressTint="@color/nova_orange"
                        android:thumbTint="@color/nova_orange" />

                    <ImageButton
                        android:id="@+id/btnRadiusInc"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Increase"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider" />

            <!-- ============================================================== -->
            <!-- SECTION: ACTION MATRIX -->
            <!-- ============================================================== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:text="ACTION MATRIX"
                android:textColor="@color/nova_orange"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Select which actions appear when opening the popup menu on the Home screen or in the App Drawer"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Table Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Action"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Home"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Drawer"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 1: Edit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbEditHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbEditDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

            <!-- Row 2: Remove -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remove"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbRemoveHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbRemoveDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="false"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

            <!-- Row 3: App info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="App info"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbAppInfoHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbAppInfoDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

            <!-- Row 4: Share -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Share"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbShareHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbShareDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

            <!-- Row 5: Widgets -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Widgets"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbWidgetsHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbWidgetsDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

            <!-- Row 6: Uninstall -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Uninstall"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbUninstallHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="false"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbUninstallDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

            <!-- Row 7: Play Store -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Play Store"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbPlayStoreHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="false"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbPlayStoreDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="false"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

            <!-- Row 8: Force stop -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Force stop"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbForceStopHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="false"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbForceStopDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="false"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

            <!-- Row 9: Hide -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hide"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />

                <CheckBox
                    android:id="@+id/cbHideHome"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="false"
                    android:buttonTint="@color/nova_orange" />

                <CheckBox
                    android:id="@+id/cbHideDrawer"
                    android:layout_width="72dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:checked="true"
                    android:buttonTint="@color/nova_orange" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
