<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/nova_light_surface"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#33000000" />

    <!-- Header: Title + Live Color Preview + Hex Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/viewColorPreviewSwatch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_button" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvColorPickerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Custom color"
                android:textColor="@color/nova_text_brown_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvColorPickerHexLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#202534"
                android:textColor="@color/nova_text_brown_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etColorHexInput"
            android:layout_width="104dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_card_rounded"
            android:backgroundTint="#EAE4DF"
            android:gravity="center"
            android:hint="RRGGBB"
            android:inputType="textNoSuggestions"
            android:maxLength="7"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/nova_text_brown_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hue Slider -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hue"
        android:textColor="@color/nova_text_brown_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp">

        <View
            android:id="@+id/trackHue"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <SeekBar
            android:id="@+id/sbHue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="360"
            android:progressDrawable="@android:color/transparent"
            android:splitTrack="false" />
    </FrameLayout>

    <!-- Saturation Slider -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saturation"
        android:textColor="@color/nova_text_brown_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp">

        <View
            android:id="@+id/trackSaturation"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <SeekBar
            android:id="@+id/sbSaturation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressDrawable="@android:color/transparent"
            android:splitTrack="false" />
    </FrameLayout>

    <!-- Brightness / Value Slider -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Brightness"
        android:textColor="@color/nova_text_brown_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp">

        <View
            android:id="@+id/trackBrightness"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <SeekBar
            android:id="@+id/sbBrightness"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:max="100"
            android:progressDrawable="@android:color/transparent"
            android:splitTrack="false" />
    </FrameLayout>

    <!-- Preset Swatches -->
    <LinearLayout
        android:id="@+id/layoutQuickSwatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_marginBottom="18dp" />

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnColorReset"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:background="?attr/selectableItemBackground"
            android:text="Default"
            android:textColor="@color/nova_text_brown_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnColorCancel"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="?attr/selectableItemBackground"
            android:text="Cancel"
            android:textColor="@color/nova_text_brown_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnColorApply"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="?attr/selectableItemBackground"
            android:text="Apply"
            android:textColor="@color/nova_accent_orange"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
