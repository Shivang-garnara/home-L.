<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_more_shapes_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvColorDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Text Color"
        android:textColor="@color/nova_text_brown_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose desktop icon label color"
        android:textColor="@color/nova_text_brown_secondary"
        android:textSize="13sp"
        android:layout_marginTop="2dp" />

    <!-- Live Preview Card (simulates home screen wallpaper background) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card_rounded"
        android:backgroundTint="#333333">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_calculator"
                android:contentDescription="Preview App Icon" />

            <TextView
                android:id="@+id/tvDialogColorPreviewLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calculator"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:shadowColor="#88000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4" />

        </LinearLayout>

    </FrameLayout>

    <!-- Color Swatches Grid (Row 1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="20dp">

        <!-- White -->
        <FrameLayout
            android:id="@+id/swatchWhite"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circleWhite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkWhite"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#212121" />
        </FrameLayout>

        <!-- Charcoal / Dark -->
        <FrameLayout
            android:id="@+id/swatchCharcoal"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circleCharcoal"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkCharcoal"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Gray -->
        <FrameLayout
            android:id="@+id/swatchGray"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circleGray"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkGray"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Red -->
        <FrameLayout
            android:id="@+id/swatchRed"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circleRed"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkRed"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Orange -->
        <FrameLayout
            android:id="@+id/swatchOrange"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circleOrange"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkOrange"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

    </LinearLayout>

    <!-- Color Swatches Grid (Row 2) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <!-- Yellow -->
        <FrameLayout
            android:id="@+id/swatchYellow"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circleYellow"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkYellow"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#212121" />
        </FrameLayout>

        <!-- Green -->
        <FrameLayout
            android:id="@+id/swatchGreen"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circleGreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkGreen"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Blue -->
        <FrameLayout
            android:id="@+id/swatchBlue"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circleBlue"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkBlue"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Purple -->
        <FrameLayout
            android:id="@+id/swatchPurple"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circlePurple"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkPurple"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Pink -->
        <FrameLayout
            android:id="@+id/swatchPink"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            android:clickable="true"
            android:focusable="true">
            <View
                android:id="@+id/circlePink"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_color_swatch_circle" />
            <ImageView
                android:id="@+id/checkPink"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </FrameLayout>

    </LinearLayout>

    <!-- Custom Hex Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEX"
            android:textColor="@color/nova_text_brown_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#"
            android:textColor="@color/nova_text_brown_secondary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etCustomHex"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_setup_outlined_dropdown"
            android:hint="FFFFFF"
            android:text="FFFFFF"
            android:textAllCaps="true"
            android:maxLength="6"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/nova_text_brown_primary"
            android:textColorHint="@color/nova_text_brown_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnHexPreview"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set"
            android:textColor="@color/nova_accent_orange"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnColorDefault"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default"
            android:textColor="@color/nova_text_brown_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnColorCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/nova_text_brown_secondary" />

        <Button
            android:id="@+id/btnColorOk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            android:textColor="@color/nova_accent_orange"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
