<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="312dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_more_shapes_dialog"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:fontFamily="sans-serif-medium"
        android:text="More shapes"
        android:textColor="#231A24"
        android:textSize="22sp" />

    <!-- 4 Column Grid of Shape Choices -->
    <GridLayout
        android:id="@+id/gridMoreShapes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:columnCount="4"
        android:rowCount="3">

        <!-- Row 1: Square, Teardrop, Pebble, Vessel -->
        <LinearLayout
            android:tag="Square"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Square"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="Teardrop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Teardrop"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="Pebble"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Pebble"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="Vessel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Vessel"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 2: Pentagon, Hexagon, Hexagon, Heptagon -->
        <LinearLayout
            android:tag="Pentagon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Pentagon"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="Hexagon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Hexagon"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="Hexagon2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Hexagon"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="Heptagon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Heptagon"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Row 3: Octagon, Crop -->
        <LinearLayout
            android:tag="Octagon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Octagon"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:tag="Crop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#888888" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="Crop"
                android:textColor="#231A24"
                android:textSize="11sp" />
        </LinearLayout>

    </GridLayout>

</LinearLayout>
