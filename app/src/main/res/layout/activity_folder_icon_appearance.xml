<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nova_light_surface">

    <!-- Top App Bar Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/nova_text_brown_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Folder icon appearance"
            android:textColor="@color/nova_text_brown_title"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live Wallpaper Preview Container -->
    <FrameLayout
        android:id="@+id/previewBackdrop"
        android:layout_width="match_parent"
        android:layout_height="172dp"
        android:background="#262626">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivFolderIconPreview"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:scaleType="fitCenter"
                android:contentDescription="Folder Icon Preview" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Folder"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:shadowColor="#88000000"
                android:shadowDy="1"
                android:shadowRadius="3" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="40dp">

            <!-- Icon layout -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Icon layout"
                android:textColor="@color/nova_text_brown_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <GridLayout
                android:id="@+id/gridIconLayouts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:useDefaultMargins="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:background="@color/nova_divider" />

            <!-- Background shape -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Background shape"
                android:textColor="@color/nova_text_brown_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <GridLayout
                android:id="@+id/gridBackgroundShapes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:useDefaultMargins="false" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:background="@color/nova_divider" />

            <!-- Clip to background -->
            <LinearLayout
                android:id="@+id/rowClipToBackground"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbClipToBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonTint="#6D3B68"
                    app:buttonIconTint="@android:color/white" />

                <TextView
                    android:id="@+id/tvClipToBackground"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Clip to background"
                    android:textColor="@color/nova_text_brown_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Outline -->
            <LinearLayout
                android:id="@+id/rowOutline"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbOutline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonTint="#6D3B68"
                    app:buttonIconTint="@android:color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Outline"
                    android:textColor="@color/nova_text_brown_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Match folder window color -->
            <LinearLayout
                android:id="@+id/rowMatchWindowColor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbMatchWindowColor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:buttonTint="#6D3B68"
                    app:buttonIconTint="@android:color/white" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Match folder window color"
                    android:textColor="@color/nova_text_brown_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Custom Plate Colors Accordion (Visible when Match folder window color is UNCHECKED) -->
            <LinearLayout
                android:id="@+id/containerCustomIconColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#EFE9E7"
                    android:padding="10dp">

                    <LinearLayout
                        android:id="@+id/rowIconColorsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Colors"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/ivIconColorsChevron"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:src="@drawable/ic_chevron_up"
                            app:tint="@color/nova_text_brown_primary" />

                        <View
                            android:id="@+id/viewIconColorBadge"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="@drawable/bg_color_swatch_circle" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/containerIconColorsBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System palette"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="6dp" />

                        <GridLayout
                            android:id="@+id/gridIconSystemPalette"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="6" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fixed colors"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="13sp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="6dp" />

                        <GridLayout
                            android:id="@+id/gridIconFixedPalette"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="6" />

                        <LinearLayout
                            android:id="@+id/rowIconCustomColor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="4dp"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Custom color"
                                android:textColor="@color/nova_text_brown_primary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tvIconCustomHex"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="#E0E0E0"
                                android:textColor="#6D3B68"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Transparency Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Transparency"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvIconTransparencyValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20%"
                            android:textColor="#6D3B68"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/sbIconTransparency"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:layout_marginTop="6dp"
                        android:progressDrawable="@drawable/seekbar_track_nova"
                        android:thumb="@drawable/seekbar_thumb_nova" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
