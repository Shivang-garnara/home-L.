<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folderOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B0000000"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/folderCard"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_card_rounded"
        android:padding="20dp"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true">

        <!-- Folder Header with Editable Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/etFolderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Folder Name"
                android:textColorHint="@color/text_tertiary"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="18sp"
                android:inputType="textAutoCorrect|textCapWords"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:lines="1" />

            <ImageView
                android:id="@+id/btnCloseFolder"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear"
                app:tint="@color/text_secondary"
                android:contentDescription="Close Folder" />
        </LinearLayout>

        <!-- Folder Apps Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFolderApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="420dp"
            android:overScrollMode="never" />

        <!-- Page Indicator for Horizontal Paged Scroll -->
        <com.example.launcherai.ui.PageIndicatorView
            android:id="@+id/folderPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
