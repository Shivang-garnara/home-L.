<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nova_setup_bg_top"
    android:fitsSystemWindows="true">

    <!-- Step Header Bar (Progress & Back Arrow - Shown on Steps 2..5) -->
    <RelativeLayout
        android:id="@+id/headerSetupBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/btnBackSetup"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <!-- Segmented Progress Indicator (Steps 2..4) -->
        <ProgressBar
            android:id="@+id/progressSetup"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="6dp"
            android:layout_centerInParent="true"
            android:max="100"
            android:progress="25"
            android:progressDrawable="@drawable/bg_nova_bottom_nav_pill" />

        <!-- Checked Circle Icon (Step 5 All Done) -->
        <ImageView
            android:id="@+id/ivProgressChecked"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_centerInParent="true"
            android:contentDescription="@null"
            android:src="@drawable/ic_check_circle_orange"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- Content ViewPager / Container Frame -->
    <FrameLayout
        android:id="@+id/containerSetupSteps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerSetupBar">

        <!-- ================= STEP 1: WELCOME (Ref 01) ================= -->
        <RelativeLayout
            android:id="@+id/step1Welcome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Logo Mark -->
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:contentDescription="@null"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Welcome to"
                    android:textColor="@color/white"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-light"
                    android:text="LauncherAI"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="normal" />

                <!-- Get Started Button -->
                <TextView
                    android:id="@+id/btnGetStarted"
                    android:layout_width="118dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="36dp"
                    android:background="@drawable/bg_nova_bottom_nav_pill"
                    android:backgroundTint="@color/nova_accent_orange"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Get started"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Bottom Actions -->
            <TextView
                android:id="@+id/btnRestoreBackup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_margin="24dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Restore backup"
                android:textColor="@color/nova_accent_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSkipSetup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_margin="24dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Skip setup"
                android:textColor="@color/nova_accent_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <!-- ================= STEP 2: SEARCH (Ref 04) ================= -->
        <ScrollView
            android:id="@+id/step2Search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="Search"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Mode Dropdown -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Mode"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/ddSearchMode"
                        android:layout_width="wrap_content"
                        android:minWidth="120dp"
                        android:layout_height="47dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_setup_outlined_dropdown"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Immersive ▾"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- Shortcut Search Toggle -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/tglShortcutSearch"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shortcut Search"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Local on-device indexing of app shortcuts and contacts allowing fast and private universal search"
                            android:textColor="#B0FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/tglShortcutSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:checked="true"
                        app:thumbTint="@color/switch_thumb_nova"
                        app:trackTint="@color/switch_track_nova"
                        app:useMaterialThemeColors="false" />
                </RelativeLayout>

                <!-- Contact Search Toggle -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/tglContactSearch"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contact Search"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvContactSearchSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Get contact results in LauncherAI Search by granting Contact permission. Search is done locally and your contacts information never leaves the device."
                            android:textColor="#B0FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/tglContactSearch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:checked="false"
                        app:thumbTint="@color/switch_thumb_nova"
                        app:trackTint="@color/switch_track_nova"
                        app:useMaterialThemeColors="false" />
                </RelativeLayout>

                <!-- Section: Home screen -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Home screen"
                    android:textColor="@color/nova_accent_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Search bar placement (Home) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Search bar placement"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/ddSearchPlacementHome"
                        android:layout_width="wrap_content"
                        android:minWidth="155dp"
                        android:layout_height="47dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_setup_outlined_dropdown"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Dock (Below icons) ▾"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                </RelativeLayout>

                <!-- Section: App drawer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="App drawer"
                    android:textColor="@color/nova_accent_orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Search bar placement (Drawer) -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="80dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="Search bar placement"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/ddSearchPlacementDrawer"
                        android:layout_width="wrap_content"
                        android:minWidth="90dp"
                        android:layout_height="47dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_setup_outlined_dropdown"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Top ▾"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ================= STEP 3: APP DRAWER (Ref 05) ================= -->
        <ScrollView
            android:id="@+id/step3AppDrawer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="App drawer"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- App drawer style Dropdown -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:text="App drawer style"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/ddAppDrawerStyle"
                        android:layout_width="120dp"
                        android:layout_height="47dp"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_setup_outlined_dropdown"
                        android:gravity="center"
                        android:text="Vertical ▾"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </RelativeLayout>

                <!-- Show Keyboard Toggle -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/tglShowKeyboard"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show Keyboard"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Immediately show keyboard when the drawer is opened"
                            android:textColor="#B0FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/tglShowKeyboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:checked="true"
                        app:thumbTint="@color/switch_thumb_nova"
                        app:trackTint="@color/switch_track_nova"
                        app:useMaterialThemeColors="false" />
                </RelativeLayout>

                <!-- Frequently used apps Toggle -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/tglFrequentApps"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frequently used apps"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Keep commonly used apps in the top row for quick access"
                            android:textColor="#B0FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/tglFrequentApps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:checked="true"
                        app:thumbTint="@color/switch_thumb_nova"
                        app:trackTint="@color/switch_track_nova"
                        app:useMaterialThemeColors="false" />
                </RelativeLayout>

                <!-- Frequently used shortcuts Toggle -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/tglFrequentShortcuts"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Frequently used shortcuts"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Keep commonly used shortcuts in the top row for quick access"
                            android:textColor="#B0FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/tglFrequentShortcuts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:checked="true"
                        app:thumbTint="@color/switch_thumb_nova"
                        app:trackTint="@color/switch_track_nova"
                        app:useMaterialThemeColors="false" />
                </RelativeLayout>

                <!-- Smart Folders Toggle -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="80dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/tglSmartFolders"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Smart Folders"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Automatically organize my apps into folders"
                            android:textColor="#B0FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/tglSmartFolders"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:checked="true"
                        app:thumbTint="@color/switch_thumb_nova"
                        app:trackTint="@color/switch_track_nova"
                        app:useMaterialThemeColors="false" />
                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ================= STEP 4: ICON STYLE (Ref 06) ================= -->
        <ScrollView
            android:id="@+id/step4IconStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="Icon style"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Color Swatches Row with Selection Indicators -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Cyan Swatch -->
                    <FrameLayout
                        android:id="@+id/containerSwatchCyan"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/ringSwatchCyan"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_color_swatch_ring"
                            android:visibility="gone" />

                        <View
                            android:id="@+id/swatchCyan"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_nova_bottom_nav_pill"
                            android:backgroundTint="#00BCD4" />
                    </FrameLayout>

                    <!-- White Swatch -->
                    <FrameLayout
                        android:id="@+id/containerSwatchWhite"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/ringSwatchWhite"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_color_swatch_ring"
                            android:visibility="gone" />

                        <View
                            android:id="@+id/swatchWhite"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_nova_bottom_nav_pill"
                            android:backgroundTint="#FFFFFF" />
                    </FrameLayout>

                    <!-- Green Swatch -->
                    <FrameLayout
                        android:id="@+id/containerSwatchGreen"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/ringSwatchGreen"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_color_swatch_ring"
                            android:visibility="gone" />

                        <View
                            android:id="@+id/swatchGreen"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_nova_bottom_nav_pill"
                            android:backgroundTint="#00E676" />
                    </FrameLayout>

                    <!-- Magenta Swatch -->
                    <FrameLayout
                        android:id="@+id/containerSwatchMagenta"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_margin="6dp"
                        android:clickable="true"
                        android:focusable="true">

                        <View
                            android:id="@+id/ringSwatchMagenta"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_color_swatch_ring"
                            android:visibility="gone" />

                        <View
                            android:id="@+id/swatchMagenta"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_nova_bottom_nav_pill"
                            android:backgroundTint="#E040FB" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Icon Size Section -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Icon size"
                        android:textColor="@color/white"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tvIconSizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="125%"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Icon Size Slider with - and + Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnIconSizeMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="Decrease icon size"
                        android:padding="6dp"
                        android:src="@drawable/ic_minus"
                        app:tint="@color/white" />

                    <SeekBar
                        android:id="@+id/seekIconSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:max="80"
                        android:progress="55"
                        android:progressDrawable="@drawable/seekbar_track_nova"
                        android:thumb="@drawable/seekbar_thumb_nova" />

                    <ImageButton
                        android:id="@+id/btnIconSizePlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_circle_button"
                        android:contentDescription="Increase icon size"
                        android:padding="6dp"
                        android:src="@drawable/ic_plus"
                        app:tint="@color/white" />
                </LinearLayout>

                <!-- Live Preview of Masked App Icon -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivIconStylePreview"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:contentDescription="Preview icon"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/ic_launcher" />

                    <TextView
                        android:id="@+id/tvIconStylePreviewLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Preview"
                        android:textColor="#B0FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Icon Shapes Row (Matching Nova Launcher: Round Default, Squircle, Rounded square, Flower) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Round (Default in Nova 8) -->
                    <LinearLayout
                        android:id="@+id/shapeRound"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/ivShapeRound"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_nova_bottom_nav_pill"
                            android:backgroundTint="@color/nova_accent_orange" />

                        <TextView
                            android:id="@+id/tvShapeRound"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Round\n(Default)"
                            android:textColor="@color/nova_accent_orange"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Squircle -->
                    <LinearLayout
                        android:id="@+id/shapeSquircle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/ivShapeSquircle"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_nova_bottom_nav_pill"
                            android:backgroundTint="#555555" />

                        <TextView
                            android:id="@+id/tvShapeSquircle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Squircle"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Rounded Square -->
                    <LinearLayout
                        android:id="@+id/shapeRoundedSquare"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/ivShapeRoundedSquare"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_nova_bottom_nav_pill"
                            android:backgroundTint="#555555" />

                        <TextView
                            android:id="@+id/tvShapeRoundedSquare"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Rounded\nsquare"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Flower -->
                    <LinearLayout
                        android:id="@+id/shapeFlower"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <View
                            android:id="@+id/ivShapeFlower"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/bg_nova_bottom_nav_pill"
                            android:backgroundTint="#555555" />

                        <TextView
                            android:id="@+id/tvShapeFlower"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Flower"
                            android:textColor="@color/white"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- More Shapes Button (Hexagonal / Icon Button) -->
                <LinearLayout
                    android:id="@+id/btnMoreShapes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="80dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivShapeMore"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_nova_bottom_nav_pill"
                        android:backgroundTint="#555555"
                        android:contentDescription="More shapes"
                        android:padding="12dp"
                        android:src="@drawable/ic_settings"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvShapeMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="More"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- ================= STEP 5: ALL DONE! (Ref 08) ================= -->
        <RelativeLayout
            android:id="@+id/step5AllDone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:text="All done!"
                    android:textColor="@color/white"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="36dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sparkle_large" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Setup is finished"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Full-Width Go Home Button -->
            <TextView
                android:id="@+id/btnGoHome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_nova_bottom_nav_pill"
                android:backgroundTint="@color/nova_accent_orange"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Go home"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </RelativeLayout>

    </FrameLayout>

    <!-- Floating Next FAB (Steps 2..4) -->
    <ImageView
        android:id="@+id/fabNextSetup"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_setup_next_fab"
        android:clickable="true"
        android:contentDescription="Next"
        android:focusable="true"
        android:padding="16dp"
        android:src="@drawable/ic_arrow_right_white"
        android:visibility="gone" />

</RelativeLayout>
