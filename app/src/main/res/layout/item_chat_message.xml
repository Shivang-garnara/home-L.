<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- User Message Container -->
    <LinearLayout
        android:id="@+id/layoutUserMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:background="@drawable/bg_user_bubble"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvUserText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvUserTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- AI Message Container -->
    <LinearLayout
        android:id="@+id/layoutAiMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:maxWidth="320dp"
        android:orientation="vertical"
        android:background="@drawable/bg_ai_bubble"
        android:padding="14dp"
        android:visibility="visible">

        <!-- AI Header Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sparkle_ai"
                android:tint="@color/accent_gradient_end"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Nova AI"
                android:textColor="@color/accent_secondary"
                android:textStyle="bold"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Collapsible Reasoning / Thinking Box -->
        <LinearLayout
            android:id="@+id/layoutThinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tool_card"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/layoutThinkingHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvThinkingLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reasoning Process"
                    android:textColor="@color/status_blue"
                    android:textStyle="bold"
                    android:textSize="11sp" />

                <ImageView
                    android:id="@+id/ivThinkingChevron"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/status_blue"
                    android:contentDescription="@null" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvThinkingContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Tool Call Card -->
        <LinearLayout
            android:id="@+id/layoutToolCall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_tool_card"
            android:padding="8dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvToolCallName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tool Call: search_packages"
                android:textColor="@color/status_orange"
                android:textStyle="bold"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvToolCallResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- HITL Confirmation Card -->
        <LinearLayout
            android:id="@+id/layoutConfirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:padding="10dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Action Confirmation Required"
                android:textColor="@color/status_orange"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvConfirmationPrompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btnCancelAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="@color/status_red"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnConfirmAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Confirm &amp; Execute"
                    android:textColor="@color/status_green"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:padding="6dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Main AI Output Text -->
        <TextView
            android:id="@+id/tvAiText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp" />

        <!-- AI Actions Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvAiTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_tertiary"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/btnCopyAi"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_copy"
                android:tint="@color/text_secondary"
                android:contentDescription="Copy response"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
