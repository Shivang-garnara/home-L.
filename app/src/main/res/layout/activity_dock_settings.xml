<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nova_light_surface">

    <!-- Top Action Bar Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back"
            app:tint="@color/nova_text_brown_primary" />

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Dock"
            android:textColor="@color/nova_text_brown_title"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <!-- Top Live Dock Preview Card -->
            <FrameLayout
                android:id="@+id/cardDockPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_rounded"
                android:backgroundTint="#262626">

                <!-- Inner Dock Background Preview View -->
                <LinearLayout
                    android:id="@+id/dockPreviewBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <!-- Preview Icon 1: Phone -->
                    <LinearLayout
                        android:id="@+id/dockPrevItem1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/ivDockPrev1"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/status_green"
                            android:contentDescription="Phone" />

                        <TextView
                            android:id="@+id/tvDockPrev1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Phone"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Preview Icon 2: Messages -->
                    <LinearLayout
                        android:id="@+id/dockPrevItem2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/ivDockPrev2"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_messages"
                            app:tint="@color/status_blue"
                            android:contentDescription="Messages" />

                        <TextView
                            android:id="@+id/tvDockPrev2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Messages"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Preview Icon 3: App Drawer (Center) -->
                    <LinearLayout
                        android:id="@+id/dockPrevItem3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/ivDockPrev3"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_apps_drawer"
                            app:tint="@color/white"
                            android:background="@drawable/bg_circle_button"
                            android:padding="8dp"
                            android:contentDescription="Apps" />

                        <TextView
                            android:id="@+id/tvDockPrev3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Apps"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Preview Icon 4: Chrome -->
                    <LinearLayout
                        android:id="@+id/dockPrevItem4"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/ivDockPrev4"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_browser"
                            android:contentDescription="Browser" />

                        <TextView
                            android:id="@+id/tvDockPrev4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Chrome"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Preview Icon 5: Camera -->
                    <LinearLayout
                        android:id="@+id/dockPrevItem5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/ivDockPrev5"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_camera"
                            android:contentDescription="Camera" />

                        <TextView
                            android:id="@+id/tvDockPrev5"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Camera"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"
                            android:visibility="gone" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <!-- Master Toggle: Enable Dock -->
            <LinearLayout
                android:id="@+id/rowEnableDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enable"
                        android:textColor="@color/nova_text_brown_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show dock at bottom of home screen"
                        android:textColor="@color/nova_text_brown_secondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swDockEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/nova_accent_orange"
                    app:trackTint="#66D54526" />

            </LinearLayout>

            <!-- Options Container (toggleable with Enable switch) -->
            <LinearLayout
                android:id="@+id/layoutDockOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15231A18"
                    android:layout_marginBottom="16dp" />

                <!-- Section: Layout -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAYOUT"
                    android:textColor="@color/nova_accent_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <!-- Match Desktop Size Toggle -->
                <LinearLayout
                    android:id="@+id/rowMatchDesktop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Match desktop size"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sync dock icon size with desktop grid"
                            android:textColor="@color/nova_text_brown_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swMatchDesktopSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/nova_accent_orange"
                        app:trackTint="#66D54526" />

                </LinearLayout>

                <!-- Independent Icon Size Controls (visible when Match desktop is off) -->
                <LinearLayout
                    android:id="@+id/layoutDockIconSize"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dock icon size"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/tvDockIconSizeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:textColor="@color/nova_accent_orange"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <ImageButton
                            android:id="@+id/btnDockIconMinus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_stepper_button"
                            android:contentDescription="Decrease icon size"
                            android:src="@drawable/ic_minus"
                            app:tint="@color/nova_text_brown_primary" />

                        <SeekBar
                            android:id="@+id/sbDockIconSize"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:min="70"
                            android:max="150"
                            android:progress="100"
                            android:thumbTint="@color/nova_accent_orange"
                            android:progressTint="@color/nova_accent_orange" />

                        <ImageButton
                            android:id="@+id/btnDockIconPlus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_stepper_button"
                            android:contentDescription="Increase icon size"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/nova_text_brown_primary" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Label Toggle Row -->
                <LinearLayout
                    android:id="@+id/rowDockLabels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Label"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show app names under dock icons"
                            android:textColor="@color/nova_text_brown_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swDockLabels"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="@color/nova_accent_orange"
                        app:trackTint="#66D54526" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15231A18"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Section: Dock Structure -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DOCK STRUCTURE"
                    android:textColor="@color/nova_accent_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <!-- Dock Icons Count Row -->
                <LinearLayout
                    android:id="@+id/rowDockIconsCount"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dock icons"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Number of icons in dock"
                            android:textColor="@color/nova_text_brown_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDockIconsCountValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5"
                        android:textColor="@color/nova_accent_orange"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Select count"
                        android:layout_marginStart="6dp"
                        app:tint="@color/nova_icon_tint_brown" />

                </LinearLayout>

                <!-- Dock Background Row -->
                <LinearLayout
                    android:id="@+id/rowDockBackground"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dock background"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Shape, floating pill, and glass tint"
                            android:textColor="@color/nova_text_brown_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDockBackgroundValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Transparent"
                        android:textColor="@color/nova_accent_orange"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Select background"
                        android:layout_marginStart="6dp"
                        app:tint="@color/nova_icon_tint_brown" />

                </LinearLayout>

                <!-- Draw Behind Navigation Bar Toggle -->
                <LinearLayout
                    android:id="@+id/rowDrawBehindNavbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Draw behind navigation bar"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Extend dock background behind system nav"
                            android:textColor="@color/nova_text_brown_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swDrawBehindNavbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        app:thumbTint="@color/nova_accent_orange"
                        app:trackTint="#66D54526" />

                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#15231A18"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp" />

                <!-- Section: Search Bar Placement -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEARCH BAR"
                    android:textColor="@color/nova_accent_orange"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginBottom="12dp" />

                <!-- Search Bar Placement Row -->
                <LinearLayout
                    android:id="@+id/rowSearchBarPlacement"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search bar placement"
                            android:textColor="@color/nova_text_brown_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Position relative to dock hotseat"
                            android:textColor="@color/nova_text_brown_secondary"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSearchBarPlacementValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Below icons"
                        android:textColor="@color/nova_accent_orange"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Select placement"
                        android:layout_marginStart="6dp"
                        app:tint="@color/nova_icon_tint_brown" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
