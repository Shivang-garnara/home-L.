<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_more_shapes_dialog"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/tvPaddingDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Padding"
        android:textColor="@color/nova_text_brown_title"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Padding Preview -->
    <com.example.launcherai.ui.PaddingPreviewView
        android:id="@+id/paddingPreviewView"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Sliders and Level Indicators -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp">

        <!-- Horizontal Padding Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Horizontal"
                android:textColor="@color/nova_text_brown_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbPaddingHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="3"
                android:progress="0"
                android:thumbTint="@color/nova_accent_orange"
                android:progressTint="@color/nova_accent_orange" />

            <TextView
                android:id="@+id/tvPaddingHorizontalValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="None"
                android:textColor="@color/nova_accent_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Vertical Padding Slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="Vertical"
                android:textColor="@color/nova_text_brown_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/sbPaddingVertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="3"
                android:progress="0"
                android:thumbTint="@color/nova_accent_orange"
                android:progressTint="@color/nova_accent_orange" />

            <TextView
                android:id="@+id/tvPaddingVerticalValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="None"
                android:textColor="@color/nova_accent_orange"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="20dp">

        <Button
            android:id="@+id/btnPaddingCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/nova_text_brown_secondary" />

        <Button
            android:id="@+id/btnPaddingOk"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OK"
            android:textColor="@color/nova_accent_orange"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
