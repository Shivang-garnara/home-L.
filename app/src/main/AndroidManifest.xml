<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.BIND_APPWIDGET" tools:ignore="ProtectedPermissions" />

    <!-- Package visibility declarations for AppWidget providers in Android 11+ and Android 15 -->
    <queries>
        <intent>
            <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        </intent>
    </queries>

    <application
        android:name=".LauncherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LauncherAI">

        <!-- Main Home Screen Launcher Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Nova AI Chat Activity -->
        <activity
            android:name=".ai.ui.NovaAiChatActivity"
            android:exported="true"
            android:label="@string/nova_ai_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Nova AI Settings Activity -->
        <activity
            android:name=".ai.ui.NovaAiSettingsActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <!-- First-Run Setup Wizard Activity -->
        <activity
            android:name=".ui.SetupActivity"
            android:exported="true"
            android:autoRemoveFromRecents="true"
            android:theme="@style/Theme.NovaDark" />

        <!-- Nova Launcher Settings Activity -->
        <activity
            android:name=".ui.LauncherSettingsActivity"
            android:exported="true"
            android:label="Nova Launcher Settings" />

        <!-- Home Screen Settings Activity -->
        <activity
            android:name=".ui.HomeScreenSettingsActivity"
            android:exported="true"
            android:label="Home screen"
            android:theme="@style/Theme.NovaLight" />

        <!-- App Drawer Settings Activity -->
        <activity
            android:name=".ui.AppDrawerSettingsActivity"
            android:exported="true"
            android:label="App drawer"
            android:theme="@style/Theme.NovaLight" />

        <!-- Dock Settings Hub Activity -->
        <activity
            android:name=".ui.DockSettingsActivity"
            android:exported="true"
            android:label="Dock"
            android:theme="@style/Theme.NovaLight" />

        <!-- Folders Settings Activity -->
        <activity
            android:name=".ui.FolderSettingsActivity"
            android:exported="true"
            android:label="Folders"
            android:parentActivityName=".ui.LauncherSettingsActivity"
            android:theme="@style/Theme.NovaLight" />

        <!-- Look & Feel Settings Activity -->
        <activity
            android:name=".ui.LookFeelSettingsActivity"
            android:exported="true"
            android:label="Look &amp; feel"
            android:parentActivityName=".ui.LauncherSettingsActivity"
            android:theme="@style/Theme.NovaLight" />

        <!-- Dedicated Popup Menu Settings Activity -->
        <activity
            android:name=".ui.PopupMenuSettingsActivity"
            android:exported="true"
            android:label="Popup menu"
            android:parentActivityName=".ui.LookFeelSettingsActivity"
            android:theme="@style/Theme.NovaDark" />

        <!-- Reverse Engineered Endpoints & Telemetry Inspector -->
        <activity
            android:name=".network.EndpointsActivity"
            android:exported="true"
            android:label="@string/endpoints_inspector_title" />

        <!-- Package Lifecycle Broadcast Receiver -->
        <receiver
            android:name=".receiver.PackageMonitorReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_CHANGED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
